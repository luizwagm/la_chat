# ==========================================================================
#  LA Chat — modelo de configuração
#
#  COPIE para `.env` e preencha. Este arquivo NÃO contém segredo nenhum e é
#  versionado; o `.env` é ignorado pelo git e nunca deve ser commitado.
#
#  EM PRODUÇÃO ISTO NÃO É UM ARQUIVO DO PROJETO. Os valores moram em
#  /etc/lachat.env, com dono root e grupo do serviço, modo 640:
#
#      install -o root -g deploy -m 640 /dev/null /etc/lachat.env
#
#  O motivo: o conteúdo de uma unit do systemd é legível por qualquer um com
#  `systemctl cat`, e um segredo dentro do projeto acaba num backup, num zip
#  mandado por e-mail ou num `git add .` distraído.
# ==========================================================================

# ------------------------------------------------------------------ rede
PORT=5197
HOST=127.0.0.1
NODE_ENV=development

# Endereço público do chat, sem barra no fim.
CHAT_BASE=http://127.0.0.1:5197

# ==========================================================================
#  ORIGENS AUTORIZADAS  —  OBRIGATÓRIO EM PRODUÇÃO
#
#  Os sites que podem abrir o chat, separados por vírgula. É esta lista que
#  impede Cross-Site WebSocket Hijacking: o navegador NÃO aplica same-origin a
#  WebSocket, então sem ela qualquer site que o funcionário visitasse poderia
#  abrir um socket autenticado com o cookie dele.
#
#  Vazio = recusa todo mundo. Nunca = libera todo mundo.
# ==========================================================================
CHAT_ORIGENS=http://127.0.0.1:5199,http://localhost:5199

# ==========================================================================
#  SEGREDOS  —  gere cada um com:   openssl rand -base64 32
#                          ou com:  npm run chave
#
#  NUNCA reaproveite o mesmo valor nos dois. Eles protegem coisas diferentes e
#  precisam poder ser trocados em separado.
# ==========================================================================

# Assina o passe que o hospedeiro emite. O MESMO valor vai no conector, do
# lado do site. É ele que faz o chat aceitar "este é o João" sem pedir senha.
CHAT_SEGREDO_PASSE=

# Deriva os tokens da busca (índice cego). Separado da chave dos dados: se um
# vazar, o outro continua não entregando nada.
CHAT_SEGREDO_BUSCA=

# Cifra o corpo das mensagens e os campos pessoais (AES-256-GCM).
# 32 bytes em base64. PERDER ESTA CHAVE É PERDER O HISTÓRICO — guarde-a junto
# do backup, mas NUNCA dentro dele.
CHAT_DADOS_CHAVE=

# Durante uma rotação de chave, a anterior fica aqui: o sistema continua LENDO
# o que foi escrito com ela, mas só ESCREVE com a atual.
# CHAT_DADOS_CHAVE_ANTERIOR=

# ------------------------------------------------------------------ banco
# "sqlite" (padrão, sem servidor) ou "pg" (volume alto / mais de um processo)
CHAT_BANCO=sqlite
CHAT_SQLITE=./dados/chat.db

# Só quando CHAT_BANCO=pg
# PGHOST=127.0.0.1
# PGPORT=5432
# PGDATABASE=lachat
# PGUSER=lachat
# PGPASSWORD=
# PGMAX=10

# --------------------------------------------------------------- arquivos
# Fora de qualquer pasta servida pelo nginx — todo download passa pela
# conferência de "quem pede é membro da conversa?".
CHAT_ARQUIVOS=./dados/arquivos
CHAT_ARQUIVO_MAX=10485760

# ---------------------------------------------------------------- limites
CHAT_LIM_MSG=30
CHAT_LIM_TAMANHO=4000
CHAT_LIM_UPLOAD=60
CHAT_LIM_BUSCA=20
CHAT_LIM_CONEXOES=6

# --------------------------------------------------------------- realtime
CHAT_PING_MS=25000
CHAT_MORTO_MS=60000

# ==========================================================================
#  PROXIES CONFIÁVEIS  —  leia antes de mudar. CONTE OS SALTOS.
#
#  É o número de itens descartados do FIM de X-Forwarded-For para achar o IP
#  real. Pegar o PRIMEIRO item — o erro natural, e o que este ecossistema já
#  cometeu em quatro servidores — é confiar em texto escrito pelo atacante:
#  ele manda `X-Forwarded-For: 1.2.3.4` e passa a escolher qual IP a auditoria
#  registra e qual endereço o limitador pune.
#
#  CONTE OS SALTOS ATÉ AQUI:
#
#    navegador -> nginx -> chat                          CHAT_PROXIES=1
#    navegador -> nginx -> site (conector) -> chat       CHAT_PROXIES=2
#                                                        ^^^ ARRANJO A
#
#  O arranjo A é o RECOMENDADO, e ele tem DOIS saltos. Usar 1 ali faz o chat
#  enxergar o próprio conector: todo visitante vira 127.0.0.1, o limitador
#  passa a contar a empresa inteira como um endereço só (uma pessoa errando a
#  senha tranca todo mundo junto) e a auditoria grava o mesmo hash para todos.
#
#  Errar para MAIS tem o mesmo efeito. Errar para MENOS reabre a falsificação.
#  O serviço avisa no log quando detecta o erro, e o `verificar.sh` confere.
# ==========================================================================
CHAT_PROXIES=1

# -------------------------------------------------------------- retenção
# 0 = guardar para sempre. Qualquer outro valor APAGA mensagens antigas — é
# decisão do cliente, com implicação jurídica, e por isso não vem ligada.
CHAT_RETENCAO_DIAS=0
