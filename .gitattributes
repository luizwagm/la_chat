# ==========================================================================
#  FIM DE LINHA — isto não é preferência de estilo, é o que impede um deploy
#  de falhar sem explicação.
#
#  O projeto é escrito no Windows e roda no Linux. Um `.sh` que chegue ao
#  servidor com CRLF produz:
#
#      ./deploy.sh: line 2: $'\r': command not found
#
#  ou, pior, um erro que não menciona o `\r` em lugar nenhum — o shell
#  simplesmente não acha o interpretador, porque procura por
#  "/usr/bin/env bash\r".
#
#  O caractere é invisível no editor. Já custou uma tarde neste parque.
# ==========================================================================
* text=auto eol=lf

*.sh      text eol=lf
*.service text eol=lf
*.conf    text eol=lf
*.js      text eol=lf
*.cjs     text eol=lf
*.json    text eol=lf
*.md      text eol=lf
*.html    text eol=lf
*.sql     text eol=lf

# Binários não são tocados.
*.png binary
*.jpg binary
*.ico binary
*.db  binary
